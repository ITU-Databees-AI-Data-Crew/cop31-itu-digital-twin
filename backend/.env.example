# Copy to backend/.env and fill in. backend/.env is gitignored: never commit keys.

# Required for the chat helper (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: better web search for the helper (without it, DuckDuckGo is used)
TAVILY_API_KEY=

# Optional: another OpenRouter model with tool calling (default: xiaomi/mimo-v2.6-pro)
COP31_MODEL=

